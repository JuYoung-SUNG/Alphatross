---
/** 단순 선 아이콘 세트. currentColor 를 따르므로 라이트·다크 모두에서 잘 보입니다. */
export interface Props {
  name: 'coin' | 'discount' | 'form' | 'alert' | 'search' | 'transit' | 'map' | 'clock';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'coin' && (
    <>
      <ellipse cx="12" cy="6.5" rx="7.5" ry="3.2" />
      <path d="M4.5 6.5v11c0 1.8 3.4 3.2 7.5 3.2s7.5-1.4 7.5-3.2v-11" />
      <path d="M4.5 12c0 1.8 3.4 3.2 7.5 3.2s7.5-1.4 7.5-3.2" />
    </>
  )}
  {name === 'discount' && (
    <>
      <path d="M20.5 12.6l-8 8a2 2 0 0 1-2.8 0l-6.3-6.3a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.9a2 2 0 0 1 1.4.6l6.4 6.4a2 2 0 0 1 0 2.6z" />
      <circle cx="8.2" cy="7.8" r="1.4" />
      <path d="M11 16l5-5" />
    </>
  )}
  {name === 'form' && (
    <>
      <path d="M15 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <path d="M15 3v5h5" /><path d="M8 13h8" /><path d="M8 17h5" />
    </>
  )}
  {name === 'alert' && (
    <>
      <path d="M10.3 3.9L2.6 17.2A2 2 0 0 0 4.3 20.2h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
      <path d="M12 9.5v4" /><path d="M12 17h.01" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" /><path d="M20 20l-4.7-4.7" />
    </>
  )}
  {name === 'transit' && (
    <>
      <rect x="4" y="3.5" width="16" height="12.5" rx="2.5" />
      <path d="M4 10.5h16" /><path d="M8 20l-1.5 1.5M16 20l1.5 1.5" />
      <path d="M7.5 16v2.5M16.5 16v2.5" />
      <circle cx="8" cy="13.2" r=".8" fill="currentColor" />
      <circle cx="16" cy="13.2" r=".8" fill="currentColor" />
    </>
  )}
  {name === 'map' && (
    <>
      <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" /><path d="M12 7.2V12l3.2 2" />
    </>
  )}
</svg>
