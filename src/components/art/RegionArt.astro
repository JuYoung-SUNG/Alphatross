---
/**
 * 지역 페이지·카드용 일러스트.
 * 공통 배경(하늘·바닥·주차 구획선) 위에 지역 성격별 실루엣을 얹는 구조입니다.
 * 외부 이미지를 쓰지 않으므로 저작권 문제가 없고 용량도 매우 작습니다.
 */
import type { RegionScene } from '../../data/regions';

export interface Props {
  scene: RegionScene;
  hue: number;
  label: string;
  /** 카드 썸네일이면 장식으로만 취급해 스크린리더에서 숨깁니다 */
  decorative?: boolean;
}
const { scene, hue, label, decorative = false } = Astro.props;
const uid = `ra-${scene}-${hue}`;
---

<svg
  class="region-art"
  viewBox="0 0 400 200"
  preserveAspectRatio="xMidYMid slice"
  style={`--h:${hue}`}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : `${label} 주차 환경을 표현한 일러스트`}
>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0%" stop-color={`hsl(${hue} 62% 58%)`} />
      <stop offset="100%" stop-color={`hsl(${hue + 22} 58% 42%)`} />
    </linearGradient>
  </defs>

  <rect width="400" height="200" fill={`url(#${uid}-sky)`} />

  <!-- 공통: 부드러운 광원 -->
  <circle cx="330" cy="42" r="86" fill="#fff" opacity=".10" />
  <circle cx="330" cy="42" r="52" fill="#fff" opacity=".10" />

  {scene === 'metro' && (
    <g fill="#fff" opacity=".22">
      <rect x="24" y="62" width="40" height="86" rx="3" />
      <rect x="72" y="36" width="32" height="112" rx="3" />
      <rect x="112" y="78" width="26" height="70" rx="3" />
      <rect x="252" y="52" width="36" height="96" rx="3" />
      <rect x="296" y="88" width="44" height="60" rx="3" />
      <rect x="348" y="66" width="28" height="82" rx="3" />
    </g>
  )}

  {scene === 'coast' && (
    <>
      <path d="M0 128q50-16 100 0t100 0 100 0 100 0v72H0z" fill="#fff" opacity=".18" />
      <path d="M0 142q50-14 100 0t100 0 100 0 100 0v58H0z" fill="#fff" opacity=".14" />
      <g fill="#fff" opacity=".3">
        <!-- 파라솔 -->
        <path d="M78 96a30 30 0 0 1 60 0z" />
        <rect x="105" y="96" width="6" height="34" rx="3" />
        <!-- 돛단배 -->
        <path d="M286 116V64l34 40z" />
        <path d="M280 116h64l-12 16h-40z" />
      </g>
    </>
  )}

  {scene === 'port' && (
    <g fill="#fff" opacity=".24">
      <path d="M40 52h8v76h-8z" /><path d="M40 52h62v7H40z" /><path d="M96 59h7v26h-7z" />
      <rect x="128" y="104" width="34" height="18" rx="2" />
      <rect x="128" y="86" width="34" height="16" rx="2" />
      <rect x="166" y="104" width="34" height="18" rx="2" />
      <path d="M262 118h96l-14 22h-68z" />
      <rect x="292" y="96" width="34" height="20" rx="2" />
    </g>
  )}

  {scene === 'planned' && (
    <g opacity=".24">
      <g fill="#fff">
        <rect x="30" y="70" width="52" height="78" rx="4" />
        <rect x="94" y="52" width="52" height="96" rx="4" />
        <rect x="262" y="64" width="52" height="84" rx="4" />
      </g>
      <g fill={`hsl(${hue} 60% 40%)`} opacity=".55">
        <rect x="40" y="82" width="12" height="10" /><rect x="60" y="82" width="12" height="10" />
        <rect x="40" y="102" width="12" height="10" /><rect x="60" y="102" width="12" height="10" />
        <rect x="104" y="64" width="12" height="10" /><rect x="124" y="64" width="12" height="10" />
        <rect x="104" y="84" width="12" height="10" /><rect x="124" y="84" width="12" height="10" />
        <rect x="272" y="76" width="12" height="10" /><rect x="292" y="76" width="12" height="10" />
      </g>
    </g>
  )}

  {scene === 'industry' && (
    <g fill="#fff" opacity=".23">
      <path d="M30 148V92l30 20V92l30 20V92l30 20v36z" />
      <rect x="112" y="60" width="16" height="88" rx="3" />
      <rect x="136" y="74" width="16" height="74" rx="3" />
      <circle cx="286" cy="88" r="24" fill="none" stroke="#fff" stroke-width="7" />
      <rect x="282" y="88" width="8" height="60" />
    </g>
  )}

  {scene === 'transit' && (
    <g opacity=".26">
      <rect x="34" y="70" width="110" height="58" rx="10" fill="#fff" />
      <rect x="46" y="80" width="34" height="24" rx="4" fill={`hsl(${hue} 60% 42%)`} />
      <rect x="90" y="80" width="42" height="24" rx="4" fill={`hsl(${hue} 60% 42%)`} />
      <circle cx="60" cy="132" r="9" fill="#fff" /><circle cx="122" cy="132" r="9" fill="#fff" />
      <path d="M188 100h150M320 84l22 16-22 16" stroke="#fff" stroke-width="9"
            fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}

  {scene === 'mountain' && (
    <g fill="#fff">
      <path d="M0 148l84-92 46 52 34-38 62 78z" opacity=".2" />
      <path d="M196 148l70-76 68 76z" opacity=".26" />
      <path d="M266 72l22 24h-44z" opacity=".5" />
    </g>
  )}

  {scene === 'rural' && (
    <g opacity=".22">
      <path d="M0 132q60-30 120 0t120 0 160 0v68H0z" fill="#fff" />
      <g fill="#fff" opacity=".85">
        <!-- 지붕이 벽보다 넓게 나와야 집으로 읽힙니다 -->
        <path d="M48 92l32-26 32 26v40H48z" />
        <path d="M254 100l26-22 26 22v32h-52z" />
        <path d="M150 108h56v24h-56z" opacity=".55" />
      </g>
      <g fill={`hsl(${hue} 60% 38%)`} opacity=".5">
        <rect x="70" y="106" width="20" height="26" rx="2" />
        <rect x="270" y="112" width="16" height="20" rx="2" />
      </g>
    </g>
  )}

  {scene === 'heritage' && (
    <g fill="#fff" opacity=".24">
      <path d="M56 84h132l16 18H40z" />
      <rect x="62" y="102" width="10" height="42" /><rect x="98" y="102" width="10" height="42" />
      <rect x="134" y="102" width="10" height="42" /><rect x="170" y="102" width="10" height="42" />
      <rect x="46" y="144" width="152" height="8" rx="2" />
      <path d="M104 66h36l10 14h-56z" />
      <g opacity=".8">
        <rect x="286" y="96" width="30" height="48" rx="3" />
        <path d="M280 98l21-16 21 16z" />
      </g>
    </g>
  )}

  {scene === 'island' && (
    <>
      <path d="M0 134q50-14 100 0t100 0 100 0 100 0v66H0z" fill="#fff" opacity=".16" />
      <g fill="#fff" opacity=".28">
        <!-- 분화구가 팬 오름 -->
        <path d="M212 132q30-58 58-58t58 58z" />
        <path d="M252 78q18-12 36 0-18 10-36 0z" fill={`hsl(${hue} 55% 44%)`} opacity=".85" />
        <path d="M44 132q26-42 60-14 20 16 30 14z" opacity=".7" />
      </g>
      <g fill="#fff" opacity=".34">
        <path d="M140 118h44l-8 12h-28z" />
        <rect x="159" y="102" width="4" height="16" rx="2" />
      </g>
    </>
  )}

  <!-- 공통: 바닥과 주차 구획 -->
  <rect y="152" width="400" height="48" fill="#0b1622" opacity=".2" />
  <g stroke="#fff" stroke-opacity=".5" stroke-width="4" stroke-linecap="round">
    <path d="M28 200v-30" /><path d="M96 200v-30" /><path d="M164 200v-30" />
    <path d="M232 200v-30" /><path d="M300 200v-30" /><path d="M368 200v-30" />
    <path d="M0 170h400" stroke-opacity=".32" />
  </g>

  <!-- 공통: P 표지 -->
  <g transform="translate(340 108)">
    <rect width="38" height="38" rx="9" fill="#fff" opacity=".92" />
    <path d="M13 30V8h9.4c5.2 0 8.6 3.2 8.6 8.3 0 5.2-3.4 8.4-8.6 8.4H18V30h-5zm5-9.4h3.6c2.4 0 3.8-1.3 3.8-3.6s-1.4-3.6-3.8-3.6H18v7.2z"
          fill={`hsl(${hue} 62% 42%)`} />
  </g>
</svg>

<style>
  .region-art {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
</style>
