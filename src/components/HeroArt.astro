---
/** 홈 상단 일러스트 — 외부 이미지 없이 인라인 SVG로 그려 저작권 문제가 없습니다. */
---

<svg
  class="hero-art"
  viewBox="0 0 520 340"
  role="img"
  aria-labelledby="heroArtTitle heroArtDesc"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="heroArtTitle">공영주차장 안내 일러스트</title>
  <desc id="heroArtDesc">
    도시 건물과 주차 표지판, 주차 구획선에 세워진 자동차를 단순화해 표현한 그림입니다.
  </desc>

  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--brand-soft)" />
      <stop offset="100%" stop-color="transparent" />
    </linearGradient>
    <linearGradient id="signGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a72d1" />
      <stop offset="100%" stop-color="#0e4a8d" />
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="520" height="340" fill="url(#sky)" rx="18" />

  <!-- 도시 실루엣 -->
  <g fill="currentColor" opacity=".13">
    <rect x="18" y="118" width="52" height="132" rx="4" />
    <rect x="78" y="86" width="40" height="164" rx="4" />
    <rect x="126" y="132" width="34" height="118" rx="4" />
    <rect x="392" y="104" width="46" height="146" rx="4" />
    <rect x="446" y="140" width="56" height="110" rx="4" />
  </g>
  <g fill="var(--bg)" opacity=".55">
    <rect x="86" y="100" width="9" height="11" rx="1.5" /><rect x="101" y="100" width="9" height="11" rx="1.5" />
    <rect x="86" y="122" width="9" height="11" rx="1.5" /><rect x="101" y="122" width="9" height="11" rx="1.5" />
    <rect x="86" y="144" width="9" height="11" rx="1.5" /><rect x="101" y="144" width="9" height="11" rx="1.5" />
    <rect x="400" y="120" width="10" height="12" rx="1.5" /><rect x="418" y="120" width="10" height="12" rx="1.5" />
    <rect x="400" y="146" width="10" height="12" rx="1.5" /><rect x="418" y="146" width="10" height="12" rx="1.5" />
  </g>

  <!-- 바닥 -->
  <rect x="0" y="250" width="520" height="90" fill="currentColor" opacity=".06" />
  <line x1="0" y1="250" x2="520" y2="250" stroke="currentColor" stroke-opacity=".18" stroke-width="2" />

  <!-- 주차 구획선 -->
  <g stroke="var(--accent)" stroke-width="3" stroke-linecap="round" opacity=".65">
    <path d="M150 336 L182 262" /><path d="M232 336 L252 262" />
    <path d="M314 336 L322 262" /><path d="M396 336 L392 262" />
    <path d="M168 262 H400" />
  </g>

  <!-- 자동차 -->
  <g transform="translate(196 268)">
    <path
      d="M6 30c0-3 1-6 3-8l7-9c2-3 5-4 8-4h34c3 0 6 1 8 4l7 9c2 2 3 5 3 8v10a4 4 0 0 1-4 4h-6a9 9 0 0 1-18 0H31a9 9 0 0 1-18 0H10a4 4 0 0 1-4-4z"
      fill="url(#signGrad)"
    />
    <path d="M24 12h30l7 9H17z" fill="#dceafa" opacity=".92" />
    <circle cx="22" cy="44" r="6.5" fill="#1b2733" /><circle cx="22" cy="44" r="2.6" fill="#c8d6e5" />
    <circle cx="58" cy="44" r="6.5" fill="#1b2733" /><circle cx="58" cy="44" r="2.6" fill="#c8d6e5" />
  </g>

  <!-- P 표지판 -->
  <g transform="translate(300 96)">
    <rect x="30" y="86" width="7" height="76" rx="3" fill="currentColor" opacity=".45" />
    <rect x="0" y="0" width="68" height="90" rx="12" fill="url(#signGrad)" />
    <rect x="6" y="6" width="56" height="78" rx="8" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="2.5" />
    <path
      d="M23 70V22h15.5c8.7 0 14.3 5.3 14.3 13.6 0 8.5-5.6 13.7-14.3 13.7H32V70h-9zm9-28.6h6.1c3.9 0 6.1-2.1 6.1-5.8s-2.2-5.8-6.1-5.8H32v11.6z"
      fill="#fff"
    />
  </g>

  <!-- 위치 핀 -->
  <g transform="translate(96 150)" opacity=".9">
    <path d="M18 0a18 18 0 0 0-18 18c0 13 18 34 18 34s18-21 18-34A18 18 0 0 0 18 0z" fill="var(--accent)" />
    <circle cx="18" cy="18" r="7" fill="var(--bg)" />
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    color: var(--text);
    border-radius: 18px;
  }
</style>
