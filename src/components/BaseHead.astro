---
import { SITE_NAME, SITE_DESCRIPTION, ADSENSE_CLIENT, PUBLISHER, normalizePath } from '../consts';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** 목록/정책 페이지는 'website', 가이드 글은 'article' */
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  /** 검색엔진 색인 제외가 필요한 페이지 */
  noindex?: boolean;
  /** 페이지 고유 구조화 데이터 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://example.com');
const canonical = new URL(normalizePath(Astro.url.pathname), siteUrl).href;
const ogImage = new URL('/og-default.png', siteUrl).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;

// 사이트 전역 구조화 데이터
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: siteUrl.href,
  description: SITE_DESCRIPTION,
  inLanguage: 'ko-KR',
  publisher: { '@type': 'Organization', name: PUBLISHER, url: siteUrl.href },
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="author" content={PUBLISHER} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#1462b8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#10161d" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME} 대표 이미지`} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 아이콘 / 피드 -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- 구조화 데이터 -->
<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
{extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

<!-- 애드센스: consts.ts 의 ADSENSE_CLIENT 값을 채우면 자동으로 삽입됩니다 -->
{ADSENSE_CLIENT && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
    crossorigin="anonymous"
  />
)}
