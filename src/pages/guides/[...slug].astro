---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { PUBLISHER } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'guides'> };
const { entry } = Astro.props;
const { Content } = await render(entry);

const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((g) => g.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx < all.length - 1 ? all[idx + 1] : undefined;
const related = all.filter((g) => g.data.category === entry.data.category && g.id !== entry.id).slice(0, 3);

const url = new URL(`/guides/${entry.id}`, Astro.site).href;
const updated = entry.data.updatedAt ?? entry.data.publishedAt;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishedAt,
    dateModified: updated,
    inLanguage: 'ko-KR',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: PUBLISHER },
    publisher: { '@type': 'Organization', name: PUBLISHER },
    keywords: entry.data.keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: '주차 가이드', item: new URL('/guides', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
];
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: '주차 가이드', href: '/guides' }, { label: entry.data.title }]}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={updated}
  jsonLd={jsonLd}
>
  <p class="meta-line">
    <span class="badge">{entry.data.category}</span>
    <span> · 작성 {entry.data.publishedAt}</span>
    {entry.data.updatedAt && <span> · 수정 {entry.data.updatedAt}</span>}
  </p>

  <article class="prose">
    <Content />
  </article>

  {related.length > 0 && (
    <section class="section">
      <h2>같은 주제의 다른 글</h2>
      <div class="grid grid-2">
        {related.map((g) => (
          <a class="card" href={`/guides/${g.id}`}>
            <span class="card-meta">{g.data.category}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <nav class="pager" aria-label="이전 다음 글">
    {prev ? (
      <a class="pager-item" href={`/guides/${prev.id}`}>
        <span class="card-meta">← 이전 글</span>
        <strong>{prev.data.title}</strong>
      </a>
    ) : <span />}
    {next && (
      <a class="pager-item pager-next" href={`/guides/${next.id}`}>
        <span class="card-meta">다음 글 →</span>
        <strong>{next.data.title}</strong>
      </a>
    )}
  </nav>

  <p style="margin-top:2rem"><a href="/guides">← 가이드 전체 목록</a></p>
</PageLayout>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager-item {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: var(--bg-elev);
  }
  .pager-item:hover { border-color: var(--brand); }
  .pager-item strong { font-size: .96rem; line-height: 1.5; }
  .pager-next { text-align: right; }
  @media (max-width: 620px) { .pager { grid-template-columns: 1fr; } }
</style>
