---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import { REGIONS } from '../data/regions';
import { SITE_NAME, SITE_DESCRIPTION, SOURCES } from '../consts';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = guides.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '전국 시·도별 공영주차장 안내',
  itemListElement: REGIONS.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${r.name} 공영주차장 안내`,
    url: new URL(`/regions/${r.slug}`, Astro.site).href,
  })),
};
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero">
      <div class="hero-text">
        <p class="badge">전국 17개 시·도 · 12편의 주차 가이드</p>
        <h1>전국 공영주차장,<br />제도부터 요금까지 한곳에</h1>
        <p class="page-lead">
          공영주차장은 지역마다 요금 체계와 감면 기준이 다릅니다. 이 사이트는 공개된 법령과
          지방자치단체 고시, 공공데이터를 바탕으로 <strong>어떻게 확인하고 어떻게 아낄 수 있는지</strong>를
          정리합니다.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/regions">지역별 안내 보기</a>
          <a class="btn btn-ghost" href="/guides">주차 가이드 읽기</a>
        </div>
      </div>
      <div class="hero-media">
        <HeroArt />
      </div>
    </section>

    <section class="section">
      <h2>이 사이트로 해결할 수 있는 것</h2>
      <div class="grid grid-3">
        <div class="card">
          <span class="card-meta">요금</span>
          <h3>주차요금이 왜 다른지</h3>
          <p>급지·기본요금·추가 단위·일일 상한이 어떻게 맞물려 최종 금액이 되는지 계산 예시로 설명합니다.</p>
        </div>
        <div class="card">
          <span class="card-meta">감면</span>
          <h3>내가 감면 대상인지</h3>
          <p>장애인·국가유공자·경차·저공해차·다자녀 등 감면 대상과 필요한 증빙을 정리했습니다.</p>
        </div>
        <div class="card">
          <span class="card-meta">절차</span>
          <h3>정기권·거주자주차 신청</h3>
          <p>모집 공고 확인부터 배점, 대기 순번 관리, 갱신·해지까지 실제 순서대로 안내합니다.</p>
        </div>
        <div class="card">
          <span class="card-meta">법규</span>
          <h3>과태료를 피하는 기준</h3>
          <p>절대 주정차 금지구역, 장애인전용구역, 전기차 충전구역의 규정을 구분해 설명합니다.</p>
        </div>
        <div class="card">
          <span class="card-meta">탐색</span>
          <h3>정확한 정보를 찾는 법</h3>
          <p>공공데이터포털과 자치법규에서 요금·운영시간을 직접 확인하는 방법을 안내합니다.</p>
        </div>
        <div class="card">
          <span class="card-meta">절약</span>
          <h3>도심 주차비 줄이기</h3>
          <p>환승주차장과 부설주차장 개방 사업을 활용해 비용을 낮추는 구체적인 방법을 다룹니다.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>지역별 공영주차장 안내</h2>
      <p>
        시·도를 선택하면 해당 지역의 주차 환경 특징, 요금 체계의 구조, 이용 요령과 공식 확인처를
        볼 수 있습니다.
      </p>
      <ul class="region-list">
        {REGIONS.map((r) => (
          <li>
            <a href={`/regions/${r.slug}`} style={`--h:${r.hue}`}>
              <span class="region-name">{r.name}</span>
              <span class="region-sub">공영주차장</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>주차 가이드</h2>
      <div class="grid grid-2">
        {featured.map((g) => (
          <a class="card" href={`/guides/${g.id}`}>
            <span class="card-meta">{g.data.category}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
      <div class="btn-row">
        <a class="btn btn-ghost" href="/guides">가이드 전체 보기</a>
      </div>
    </section>

    <section class="section">
      <div class="notice">
        <p>
          <strong>정보의 출처와 한계</strong>
        </p>
        <p>
          이 사이트는 <a href={SOURCES.lawCenter} rel="noopener noreferrer" target="_blank">국가법령정보센터</a>의
          법령·자치법규와 <a href={SOURCES.dataPortal} rel="noopener noreferrer" target="_blank">공공데이터포털</a>의
          공개 데이터, 각 지방자치단체의 고시를 참고해 작성되었습니다.
        </p>
        <p>
          다만 주차요금과 운영시간, 감면 기준은 조례 개정에 따라 수시로 바뀝니다. 따라서 이 사이트는
          <strong> 구체적인 금액을 단정하지 않고 제도의 구조</strong>를 설명하며, 실제 이용 전에는 반드시
          해당 지자체의 최신 고시를 확인하도록 안내하고 있습니다. 자세한 내용은
          <a href="/disclaimer">면책조항</a>을 참고하세요.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem 0 1rem;
  }
  .hero h1 { margin-top: .6rem; }
  .hero .page-lead { margin-bottom: 0; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 1.5rem; }
    .hero-media { order: -1; }
  }

  .region-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: .7rem;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
  }
  .region-list a {
    display: flex;
    flex-direction: column;
    gap: .1rem;
    padding: .9rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid var(--border);
    background: color-mix(in srgb, hsl(var(--h) 70% 50%) 7%, var(--bg-elev));
    transition: transform .15s ease, border-color .15s ease;
  }
  .region-list a:hover {
    transform: translateY(-2px);
    border-color: hsl(var(--h) 65% 50%);
  }
  .region-name { font-weight: 800; font-size: 1.05rem; color: var(--text); letter-spacing: -.02em; }
  .region-sub { font-size: .8rem; color: var(--text-muted); }
</style>
